# ==============================================================================
# SUBVENCIONES-CORE - Configuración de Entorno (.env)
# ==============================================================================

# Entorno de la aplicación: development | staging | production
APP_ENV=development

# Configuración de Base de Datos PostgreSQL / pgvector
# En entorno local usar 'localhost', en docker-compose usar 'db'
POSTGRES_USER=subve_user
POSTGRES_PASSWORD=subve_password
POSTGRES_DB=subvenciones_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# URL Base para tracking y redirección de notificaciones
BASE_URL_TRACKING=http://localhost:8000/t

# Rutas persistentes y temporales relativas
DATA_DIR=./data
LOGS_DIR=./logs
